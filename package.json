{
  "name": "ucasal-cronogramas-api",
  "version": "1.0.0",
  "description": "API REST para gestionar cronogramas de exámenes de la Universidad Católica de Salta",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm install && npm run db:generate",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "db:generate": "npx prisma generate",
    "db:push": "npx prisma db push",
    "db:studio": "npx prisma studio",
    "setup": "npm run db:push && node scripts/totem-master.js",
    "clean:cache": "rm -rf node_modules/.cache .next/cache || true",
    "postinstall": "npm run db:generate"
  },
  "dependencies": {
    "@prisma/client": "^6.9.0",
    "axios": "^1.7.7",
    "dotenv": "^16.5.0",
    "mysql2": "^3.14.1",
    "next": "^15.0.3",
    "node-cron": "^3.0.3",
    "prisma": "^6.9.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.9",
    "@types/react": "19.2.7",
    "eslint": "^9.13.0",
    "eslint-config-next": "^15.0.3"
  },
  "keywords": [
    "api",
    "rest",
    "cronogramas",
    "examenes",
    "universidad",
    "next.js",
    "prisma",
    "mysql"
  ],
  "author": "UCASAL",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
